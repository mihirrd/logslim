{
  "name": "logslim-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing LogSlim's structured logs to AI agents — templates, anomalies, and exact replay instead of raw log dumps.",
  "type": "module",
  "bin": {
    "logslim-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
